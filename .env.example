# Copy to .env for local development.
# On Render, set these same keys under Environment instead — .env is gitignored
# and is never part of the deployed image.

# ── Database ──
DB_URL= database_url
DB_USER=demo_user
DB_PASSWORD= demo_pass

# ── AI ──
GEMINI_API_KEY=
GEMINI_MODEL=

# ── Mock Interview payments ──

# REQUIRED. The bKash number students are told to send money to. If this is not
# set, the checkout page shows the literal placeholder below and nobody can pay.
BKASH_MERCHANT_NUMBER=01XXXXXXXXX

# Label shown on checkout: Personal (Send Money) or Merchant (Payment).
BKASH_ACCOUNT_TYPE=Personal

# Platform commission, in percent. Read when a booking is created and frozen
# into bookings.platform_fee_bdt, so changing it only affects future bookings.
PLATFORM_FEE_PERCENT=20

# Payment strategy. 'manual' = bKash send-money with admin verification, the
# only implementation today. Unknown values fall back to manual.
PAYMENT_PROVIDER=manual
